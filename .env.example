# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLOUD_PROJECT=my-gcp-project

# Table analyzed by default when running `python -m src.agent`
BQ_DATASET=ecommerce_demo
BQ_TABLE=orders

# --- Cube mode only (python -m src.cube_agent) ---
# Base URL of the Cube Cloud REST API
CUBE_API_URL=https://<deployment>.cubecloud.dev/cubejs-api/v1
# JWT sent in the Authorization header
CUBE_API_TOKEN=

# --- Optional ---
# LangSmith tracing; leave empty to run without traces
LANGSMITH_API_KEY=

# Set to true to load ANTHROPIC_API_KEY / LANGSMITH_API_KEY from Google Secret
# Manager instead of this file. Requires the secrets `anthropic-api-key` and
# `langsmith-api-key` to exist in GOOGLE_CLOUD_PROJECT.
USE_SECRET_MANAGER=false
